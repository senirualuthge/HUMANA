# ─── Server ───────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-32-char-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Database ─────────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./humana.db
# Postgres (prod):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/humana

# ─── LLM Providers ────────────────────────────────
LLM_PROVIDER=openai           # openai | anthropic
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── Embeddings ───────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2   # local sentence-transformers model
# or for OpenAI embeddings:
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=openai

# ─── Vector Store ─────────────────────────────────
CHROMA_PATH=./chroma_data
CHROMA_HOST=                  # leave blank = in-process

# ─── ElevenLabs TTS ───────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Redis (optional session store) ───────────────
REDIS_URL=redis://localhost:6379/0

# ─── RAG Tuning ───────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35
